GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-3.8-flash

# Keep password mode until SMTP delivery has been verified. Opt in with AUTH_MODE=email-otp.
AUTH_MODE=password
# Required in email-otp mode. Use a separate random secret at least 32 bytes long.
OTP_SECRET=
SMTP_HOST=
# SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Model names change over time. To check the working ones: cd backend && python check_models.py
